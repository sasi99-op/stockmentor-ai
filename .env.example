# ==============================================================================
# StockMentor AI - Environment Variables
# Copy this file to `.env.local` for local development.
# ==============================================================================

# Supabase Public Configuration (Exposed to browser safely)
# Obtain these from: Supabase Project Dashboard -> Settings (gear icon) -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NOTE: NEVER expose SUPABASE_SERVICE_ROLE_KEY here or to client code.
# The service role key bypasses Row Level Security and must remain private on servers if ever used.
